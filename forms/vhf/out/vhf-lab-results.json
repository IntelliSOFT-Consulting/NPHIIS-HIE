{
  "resourceType": "Questionnaire",
  "id": "vhf-lab-results",
  "url": "http://nphiis.health.go.ke/Questionnaire/vhf-lab-results",
  "name": "vhf_lab_results",
  "title": "VHF - Lab Information",
  "status": "active",
  "item": [
    {
      "linkId": "vhf-laboratory",
      "text": "Laboratory",
      "type": "group",
      "item": [
        {
          "linkId": "date_sample_received",
          "text": "Date sample received at the laboratory",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            },
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            }
          ]
        },
        {
          "linkId": "condition_of_sample",
          "text": "Condition of sample",
          "type": "choice",
          "required": true,
          "answerOption": [
            {
              "valueCoding": {
                "code": "good",
                "display": "Good"
              }
            },
            {
              "valueCoding": {
                "code": "spoiled",
                "display": "Spoiled"
              }
            }
          ],
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ]
        },
        {
          "linkId": "laboratory_tests",
          "text": "Laboratory tests performed (tick all that apply)",
          "type": "choice",
          "required": true,
          "answerOption": [
            {
              "valueCoding": {
                "code": "pcr",
                "display": "PCR"
              }
            },
            {
              "valueCoding": {
                "code": "elisa",
                "display": "ELISA"
              }
            },
            {
              "valueCoding": {
                "code": "antigen_rapid_test",
                "display": "Antigen rapid test (RDT)"
              }
            },
            {
              "valueCoding": {
                "code": "serology",
                "display": "Serology"
              }
            },
            {
              "valueCoding": {
                "code": "antibodies",
                "display": "Antibodies"
              }
            },
            {
              "valueCoding": {
                "code": "sequencing",
                "display": "Sequencing"
              }
            },
            {
              "valueCoding": {
                "code": "cytology",
                "display": "Cytology"
              }
            },
            {
              "valueCoding": {
                "code": "gram_stain",
                "display": "Gram stain"
              }
            },
            {
              "valueCoding": {
                "code": "unknown",
                "display": "Unknown"
              }
            },
            {
              "valueCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ],
          "repeats": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "check-box"
                  }
                ]
              }
            },
            {
              "url": "http://nphiis.health.go.ke/fhir/StructureDefinition/source-field",
              "valueString": "laboratory_tests"
            }
          ]
        },
        {
          "linkId": "laboratory_tests_other",
          "text": "Laboratory tests - other (specify)",
          "type": "string",
          "required": true,
          "extension": [
            {
              "url": "http://nphiis.health.go.ke/fhir/StructureDefinition/source-field",
              "valueString": "laboratory_tests_other"
            }
          ],
          "enableWhen": [
            {
              "question": "laboratory_tests",
              "operator": "=",
              "answerCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ]
        }
      ]
    },
    {

            {
              "url": "http://nphiis.health.go.ke/fhir/StructureDefinition/source-field",
              "valueString": "preliminary_laboratory_result"
            }
          ]
        },
        {
          "linkId": "date_of_preliminary_result",
          "text": "Date of preliminary result",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
              "extension": [
                {
                  "url": "key",
                  "valueId": "date-of-preliminary-result-after-date-sample-received"
                },
                {
                  "url": "severity",
                  "valueCode": "error"
                },
                {
                  "url": "expression",
                  "valueString": "%context.answer.value.empty() or %resource.descendants().where(linkId='date_sample_received').answer.value.empty() or %context.answer.value >= %resource.descendants().where(linkId='date_sample_received').answer.value"
                },
                {
                  "url": "human",
                  "valueString": "Must be on or after 'Date sample received at the laboratory'"
                },
                {
                  "url": "location",
                  "valueString": "date_sample_received"
                }
              ]
            },
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://nphiis.health.go.ke/fhir/StructureDefinition/source-field",
              "valueString": "date_of_preliminary_result"
            }
          ],
          "enableWhen": [
            {
              "question": "preliminary_laboratory_result",
              "operator": "=",
              "answerCoding": {
                "code": "positive",
                "display": "Positive"
              }
            },
            {
              "question": "preliminary_laboratory_result",
              "operator": "=",
              "answerCoding": {
                "code": "negative",
                "display": "Negative"
              }
            }
          ],
          "enableBehavior": "any"
        },
        {
          "linkId": "preliminary_laboratory_result_narration",
          "text": "Narration (preliminary)",
          "type": "text",
          "extension": [
            {
              "url": "http://nphiis.health.go.ke/fhir/StructureDefinition/source-field",

    {
      "name": "Patient Validation",
      "description": "Validate a patient by identification document.\n\nLookup order: **Client Registry** (DHA middleware, OAuth2 client credentials) first; on not-found, **IPRS** (SHA Health ID, Basic auth). IPRS only holds National ID (`citizen`) and Alien ID (`alien`); other types skip IPRS.\n\nResponses:\n- `200 {status, found: true, source: client-registry|iprs, patient}`: `patient` is a FHIR R4 Patient (`ClientRegistryPatient` or `IprsPatient` profile)\n- `400` FHIR `OperationOutcome` (`issue[0].code: \"not-found\"`): not in CR or IPRS\n- `400`: missing/invalid parameters\n- `401`: missing/invalid provider token (run **Admin Management > Manage Users > Login** first)\n- `502`: CR/IPRS upstream error (a CR error does not fall through to IPRS)\n- `503`: CR/IPRS not configured on the server",
      "item": [
        {
          "name": "Validate - National ID (Client Registry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"found in Client Registry\", () => {",
                  "    pm.expect(body.found).to.eql(true);",
                  "    pm.expect(body.source).to.eql(\"client-registry\");",
                  "    pm.expect(body.patient.resourceType).to.eql(\"Patient\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_HOST}}/provider/patients/validate?identification_number=1000002017&identification_type=National%20ID",
              "host": [
                "{{API_HOST}}"
              ],
              "path": [
                "provider",
                "patients",
                "validate"
              ],
              "query": [
                {
                  "key": "identification_number",
                  "value": "1000002017"
                },
                {
                  "key": "identification_type",
                  "value": "National%20ID",
                  "description": "Temporary ID | Alien ID | Refugee ID | Mandate Number | Birth Certificate | National ID | Birth Notification | ClientRegistry ID"
                }
              ]
            },
            "description": "UAT test ID held in the Client Registry; expect `source: client-registry`."
          },
          "response": []
        },
        {
          "name": "Validate - National ID (IPRS fallback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"found in IPRS\", () => {",
                  "    pm.expect(body.found).to.eql(true);",
                  "    pm.expect(body.source).to.eql(\"iprs\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_HOST}}/provider/patients/validate?identification_number=32041729&identification_type=National%20ID",
              "host": [
                "{{API_HOST}}"
              ],
              "path": [
                "provider",
                "patients",
                "validate"
              ],
              "query": [
                {
                  "key": "identification_number",
                  "value": "32041729"
                },
                {
                  "key": "identification_type",
                  "value": "National%20ID",
                  "description": "Temporary ID | Alien ID | Refugee ID | Mandate Number | Birth Certificate | National ID | Birth Notification | ClientRegistry ID"
                }
              ]
            },
            "description": "Not in the Client Registry but held in IPRS; expect `source: iprs`."
          },
          "response": []
        },
        {
          "name": "Validate - Not found (OperationOutcome)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test(\"OperationOutcome not-found\", () => {",
                  "    pm.expect(b.resourceType).to.eql(\"OperationOutcome\");",
                  "    pm.expect(b.issue[0].severity).to.eql(\"error\");",
                  "    pm.expect(b.issue[0].code).to.eql(\"not-found\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",

    {
      "name": "Registry Lookup (CR format)",
      "description": "Same lookup as **Patient Validation** (Client Registry first, IPRS on not-found), but `patient` is in the Client Registry's own JSON format instead of FHIR.\n\n- `200 {status, found: true, source: client-registry|iprs, patient}`: CR records exactly as the registry returns them; IPRS records converted to CR field names (`first_name`, `middle_name`, `last_name`, `gender`, `date_of_birth`, `citizenship`, `identification_type`, `identification_number`, `id_serial`); CR-only fields (`id`, `other_identifications`) empty.\n- Not found in either: the Client Registry's own response, `400 {error: \"Bad Request\", message: \"failed to get patient record: zero results found …\", trace_id}`.\n- `400` bad parameters, `401` missing/invalid token, `502` upstream error, `503` not configured: same as Patient Validation.",
      "item": [
        {
          "name": "Registry - National ID (Client Registry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"found in Client Registry\", () => {",
                  "    pm.expect(b.found).to.eql(true);",
                  "    pm.expect(b.source).to.eql(\"client-registry\");",
                  "});",
                  "pm.test(\"CR format\", () => {",
                  "    pm.expect(b.patient.identification_number).to.eql(\"1000002017\");",
                  "    pm.expect(b.patient).to.have.property(\"first_name\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "UAT test ID held in the Client Registry; the CR record is returned unchanged.",
            "url": {
              "raw": "{{API_HOST}}/provider/patients/registry?identification_number=1000002017&identification_type=National%20ID",
              "host": [
                "{{API_HOST}}"
              ],
              "path": [
                "provider",
                "patients",
                "registry"
              ],
              "query": [
                {
                  "key": "identification_number",
                  "value": "1000002017"
                },
                {
                  "key": "identification_type",
                  "value": "National%20ID",
                  "description": "Temporary ID | Alien ID | Refugee ID | Mandate Number | Birth Certificate | National ID | Birth Notification | ClientRegistry ID"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Registry - National ID (IPRS fallback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"found in IPRS\", () => pm.expect(b.source).to.eql(\"iprs\"));",
                  "pm.test(\"CR format\", () => {",
                  "    pm.expect(b.patient.identification_type).to.eql(\"National ID\");",
                  "    pm.expect(b.patient.identification_number).to.eql(\"32041729\");",
                  "    pm.expect(b.patient.gender).to.be.oneOf([\"Male\", \"Female\"]);",
                  "    pm.expect(b.patient).to.not.have.property(\"meta\");",
                  "});"
                ]
              }
            }
          ],

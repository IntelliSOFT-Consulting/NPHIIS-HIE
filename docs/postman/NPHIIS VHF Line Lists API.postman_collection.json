  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "API_HOST",
      "value": "https://dsrfhir.intellisoftkenya.com/api",
      "type": "default"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "default"
    },
    {
      "key": "clientSecret",
      "value": "",
      "type": "secret"
    },
    {
      "key": "token",
      "value": "",
      "type": "secret"
    },
    {
      "key": "tokenExpiresAt",
      "value": "",
      "type": "default"
    },
    {
      "key": "reportsApiKey",
      "value": "",
      "type": "secret"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Logs in with {{clientId}} / {{clientSecret}} when there is no token or it expires within a minute.",
          "// Skipped for Get token itself and for requests set to No Auth or API key.",
          "const auth = pm.request.auth;",
          "if (pm.info.requestName === \"Get token\" || (auth && auth.type && auth.type !== \"bearer\")) return;",
          "const expiresAt = Number(pm.collectionVariables.get(\"tokenExpiresAt\") || 0);",
          "if (pm.collectionVariables.get(\"token\") && Date.now() < expiresAt - 60000) return;",
          "const clientId = pm.collectionVariables.get(\"clientId\");",
          "const clientSecret = pm.collectionVariables.get(\"clientSecret\");",
          "if (!clientId || !clientSecret) throw new Error(\"Set the clientId and clientSecret collection variables\");",
          "pm.sendRequest({",
          "    url: pm.variables.replaceIn(\"{{API_HOST}}/reports/vhf/token\"),",
          "    method: \"POST\",",
          "    header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "    body: { mode: \"urlencoded\", urlencoded: [",
          "        { key: \"client_id\", value: clientId },",
          "        { key: \"client_secret\", value: clientSecret },",
          "    ] },",
          "}, (err, res) => {",
          "    if (err || res.code !== 200) {",
          "        console.error(\"Token request failed\", err || res.code, res && res.text());",
          "        return;",
          "    }",
          "    const t = res.json();",
          "    pm.collectionVariables.set(\"token\", t.access_token);",
          "    pm.collectionVariables.set(\"tokenExpiresAt\", String(Date.now() + (t.expires_in || 1800) * 1000));",
          "});"
        ]
      }
    }
  ]
}
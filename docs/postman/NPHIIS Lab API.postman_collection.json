		{
			"name": "Staff",
			"description": "Admin portal users with specimen tracking access (Bearer JWT from Login). Includes `POST /lab/updates` for entering results in the portal and `POST /lab/pull`.",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}

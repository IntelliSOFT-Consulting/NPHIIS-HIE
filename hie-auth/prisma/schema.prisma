// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CaseIdTracker {
  id           Int    @id @default(autoincrement())
  countryCode  String
  countyCode String
  subCountyCode String
  conditionCode String
  lastCaseId   Int    @default(0)

  @@unique([countryCode, countyCode, subCountyCode, conditionCode]) // enforce uniqueness of combination
}

model Notification {
  id                  String               @id @default(uuid())
  practitionerId      String
  encounterId         String
  /** AFP follow-up reminders vs immediate casesubmission alerts — separate rows per recipient (see @@unique). */
  type                NotificationType     @default(AFP_FOLLOW_UP)
  investigationDate   DateTime?
  dueDate             DateTime
  title               String
  body                String
  status              NotificationStatus   @default(PENDING)
  /** Populated when status = FAILED (FCM error, missing token, etc.). */
  failureReason       String?
  /** Set when immediate-alert SMTP succeeded; prevents duplicate email on FCM retry (`CASE_SUBMISSION`, `LAB_RESULT`). */
  caseSubmissionEmailSentAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([practitionerId, encounterId, type])
}

model NotificationRecipient {
  id String @id @default(uuid())
  practitionerId String
  token String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  AFP_FOLLOW_UP
  CASE_SUBMISSION
  LAB_RESULT
}

enum SubscriptionCallbackOutcome {
  success
  error
  skipped
}

/// Inbound REST-hook callbacks from HAPI FHIR to hie-auth (subscription notifications, manual EPID retry).
model FhirSubscriptionCallbackLog {
  id           String                     @id @default(uuid())
  createdAt    DateTime                   @default(now())
  route        String
  resourceType String
  resourceId   String?
  httpStatus   Int
  outcome      SubscriptionCallbackOutcome
  errorMessage String?
  detail       Json?
  durationMs   Int?
}

# Patient identity validation (GET /provider/patients/validate)
# Client Registry (searched first)
CR_BASE_URL=
CR_API_TOKEN=
# Or OAuth2 client credentials (DHA middleware); token fetched and cached automatically
CR_CLIENT_ID=
CR_CLIENT_SECRET=
# Optional; defaults to ${CR_BASE_URL}/api/v1/tenants/token
CR_TOKEN_URL=
CR_TIMEOUT_MS=10000
# IPRS (fallback when CR returns not found)
IPRS_BASE_URL=
IPRS_API_TOKEN=
# IPRS (SHA Health ID) Basic auth. IPRS_BASIC_AUTH (optional) is sent as-is instead of username/password.
IPRS_USERNAME=
IPRS_PASSWORD=
IPRS_BASIC_AUTH=
IPRS_TIMEOUT_MS=10000

# NPHL lab integration (VHF specimens → POST https://data-apis.nphl.go.ke/v1/surveillance)
# Key from NPHL ICT (helpdesk@nphl.go.ke). Without it, specimen Tasks stay at submission-failed.
NPHL_SURVEILLANCE_API_URL=https://data-apis.nphl.go.ke
NPHL_SURVEILLANCE_API_KEY=
NPHL_SURVEILLANCE_TIMEOUT_MS=30000
# Tests requested per specimen (comma-separated). Empty uses the default, RT-PCR. Keep stable: NPHL de-duplicates on the test set.
NPHL_VHF_LAB_TESTS=
# Re-post open cases to pick up results (runs only when the API key is set)
NPHL_POLL_CRON_SCHEDULE=*/30 * * * *
NPHL_POLL_CRON_ENABLED=true
# Specimen subscription (registered at startup with the others)
FHIR_SPECIMEN_SUBSCRIPTION_ID=nphl-specimen-subscription
FHIR_SPECIMENS_SUBSCRIPTION_CALLBACK_URL=http://hie-auth:3000/subscriptions/specimens/notifications
# Patient activity: stamps Patient extension patient-data-last-updated when related data changes
PATIENT_ACTIVITY_SUBSCRIPTION_CALLBACK_URL=http://hie-auth:3000/subscriptions/patient-activity/notifications
# Optional comma list of resource types (default: Encounter,Observation,Condition,Immunization,Specimen,
# QuestionnaireResponse,DiagnosticReport,ServiceRequest,Procedure,MedicationAdministration)
PATIENT_ACTIVITY_RESOURCE_TYPES=
# Quiet window per patient before writing, background FHIR calls in flight, max queued patients
PATIENT_ACTIVITY_DEBOUNCE_MS=3000
PATIENT_ACTIVITY_CONCURRENCY=4
PATIENT_ACTIVITY_MAX_PENDING=10000
# Key the lab system sends (x-api-key or Bearer) when pushing results/rejections to POST /lab/results
LAB_RESULTS_API_KEY=
# Optional: when set, the lab must sign each push (x-lab-timestamp + x-lab-signature, HMAC-SHA256)
LAB_RESULTS_HMAC_SECRET=
LAB_RESULTS_SIGNATURE_TOLERANCE_SECONDS=300
# Load limits: quiet window per case after a Specimen callback, NPHL calls in flight, poll bounds
NPHL_SYNC_DEBOUNCE_MS=15000
NPHL_MAX_CONCURRENT=2
NPHL_POLL_MAX_CASES=200
NPHL_POLL_MAX_AGE_DAYS=60
# NPHL lab staging API (GET https://lab-staging-api.nphl.go.ke/list): pull results that are ready
# for open specimens, matched on the tube label. Runs only when the key is set.
LAB_STAGING_API_URL=https://lab-staging-api.nphl.go.ke
LAB_STAGING_API_KEY=
LAB_STAGING_LOOKBACK_DAYS=14
LAB_STAGING_TIMEOUT_MS=60000
LAB_STAGING_POLL_CRON_SCHEDULE=15,45 * * * *
LAB_STAGING_POLL_CRON_ENABLED=true

# VHF contact follow-up daily job (contact Lists, conversions, reminders). Default 2:45 UTC = 5:45 EAT.
# VHF_CONTACT_CRON_ENABLED=false
# VHF_CONTACT_CRON_SCHEDULE=45 2 * * *

# Browser origins allowed to call this API (comma-separated). Empty = no browser origins.
CORS_ALLOWED_ORIGINS=https://admin.example.org
# Number of reverse proxies in front of this service (nginx = 1), used to read the client IP.
TRUST_PROXY_HOPS=1
# Requests per 15 minutes to login / register / refresh / reset-password.
AUTH_RATE_LIMIT_PER_IP=50
AUTH_RATE_LIMIT_PER_ACCOUNT=10

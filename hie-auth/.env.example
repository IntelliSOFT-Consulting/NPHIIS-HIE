# Patient identity validation (GET /provider/patients/validate)
# Client Registry (searched first)
CR_BASE_URL=
CR_API_TOKEN=
# Or OAuth2 client credentials (DHA middleware); token fetched and cached automatically
CR_CLIENT_ID=
CR_CLIENT_SECRET=
# Optional; defaults to ${CR_BASE_URL}/api/v1/tenants/token
CR_TOKEN_URL=
CR_TIMEOUT_MS=10000
# IPRS (fallback when CR returns not found)
IPRS_BASE_URL=
IPRS_API_TOKEN=
# IPRS (SHA Health ID) Basic auth. IPRS_BASIC_AUTH (optional) is sent as-is instead of username/password.
IPRS_USERNAME=
IPRS_PASSWORD=
IPRS_BASIC_AUTH=
IPRS_TIMEOUT_MS=10000

# NPHL lab integration (VHF specimens → POST https://data-apis.nphl.go.ke/v1/surveillance)
# Key from NPHL ICT (helpdesk@nphl.go.ke). Without it, specimen Tasks stay at submission-failed.
NPHL_SURVEILLANCE_API_URL=https://data-apis.nphl.go.ke
NPHL_SURVEILLANCE_API_KEY=
NPHL_SURVEILLANCE_TIMEOUT_MS=30000
# Tests requested per specimen (comma-separated). Empty uses the default, RT-PCR. Keep stable: NPHL de-duplicates on the test set.
NPHL_VHF_LAB_TESTS=
# Re-post open cases to pick up results (runs only when the API key is set)
NPHL_POLL_CRON_SCHEDULE=*/30 * * * *
NPHL_POLL_CRON_ENABLED=true
# Specimen subscription (registered at startup with the others)
FHIR_SPECIMEN_SUBSCRIPTION_ID=nphl-specimen-subscription
FHIR_SPECIMENS_SUBSCRIPTION_CALLBACK_URL=http://hie-auth:3000/subscriptions/specimens/notifications
# Key the lab system sends (x-api-key or Bearer) when pushing results/rejections to POST /lab/results
LAB_RESULTS_API_KEY=
# Load limits: quiet window per case after a Specimen callback, NPHL calls in flight, poll bounds
NPHL_SYNC_DEBOUNCE_MS=15000
NPHL_MAX_CONCURRENT=2
NPHL_POLL_MAX_CASES=200
NPHL_POLL_MAX_AGE_DAYS=60

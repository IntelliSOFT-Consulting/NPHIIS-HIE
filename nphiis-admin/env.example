# Keycloak (issuer used to verify access tokens server-side via JWKS)
KEYCLOAK_URL=
KEYCLOAK_REALM=nphiis
KEYCLOAK_CLIENT_ID=nphiis-admin
NEXT_PUBLIC_KEYCLOAK_URL=
NEXT_PUBLIC_KEYCLOAK_REALM=nphiis
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nphiis-admin

# FHIR upstream (server-side; the proxy injects the user's bearer token).
# Docker (HIE stack): http://hapi-fhir-jpa:8080/fhir — requires the admin container
# on the same network as HAPI (nphiis-admin/docker-compose.yml attaches to external `cloudbuild`).
# npm run dev on host: http://localhost:8787/fhir (or your HAPI URL).
FHIR_BASE_URL=

# Apache Superset embedding
SUPERSET_URL=
SUPERSET_GUEST_USER=
SUPERSET_GUEST_PASSWORD=
NEXT_PUBLIC_SUPERSET_URL=
# IDSR Case-Based Surveillance dashboard (embed UUID from
# Superset → Settings → Embed dashboard). Contains MOH 503 + MOH 502
# (AFP, Measles) tabs internally so it's the only embed we ship.
# Optional — leave blank to use the bundled default
# 363e13a5-bfd4-4ca9-b76e-ba284d5b6404.
NEXT_PUBLIC_SUPERSET_DASHBOARD_IDSR_CBS=

# Copy this file to .env and adjust values. Do not commit .env with real secrets.

# -----------------------------------------------------------------------
# Superset secret key (CVE-2023-27524)
# Set a unique random value. Generate with: openssl rand -base64 42
# Without this, Superset may use an insecure default and allow session
# forgery / unauthenticated admin access. See superset.apache.org/docs/security/cves
# For local dev (DEV_MODE=true), optional; required for non-dev (see docker-bootstrap.sh).
# You may override via docker/.env-local.
# -----------------------------------------------------------------------
SUPERSET_SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET

# Allowing python to print() in docker
PYTHONUNBUFFERED=1

COMPOSE_PROJECT_NAME=superset
DEV_MODE=true

# database configurations (do not modify)
DATABASE_DB=superset
DATABASE_HOST=db
# Make sure you set this to a unique secure random value on production
DATABASE_PASSWORD=superset
DATABASE_USER=superset

EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_USER=examples
# Make sure you set this to a unique secure random value on production
EXAMPLES_PASSWORD=examples
EXAMPLES_PORT=5432

# database engine specific environment variables
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql+psycopg2
POSTGRES_DB=superset
POSTGRES_USER=superset
# Make sure you set this to a unique secure random value on production
POSTGRES_PASSWORD=superset

# Add the mapped in /app/pythonpath_docker which allows devs to override stuff
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1
# Seconds Superset keeps chart results (default 3600). The warehouse refreshes every 2 h.
SUPERSET_DATA_CACHE_TIMEOUT=3600

FLASK_DEBUG=true
SUPERSET_APP_ROOT="/"
SUPERSET_ENV=development
SUPERSET_LOAD_EXAMPLES=yes
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=true
SUPERSET_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Keycloak OAuth2 (NPHIIS Auth via superset_config.py)
# Copy to docker/.env and set real values. Do not commit docker/.env.
# Defaults for KEYCLOAK_URL / realm / client id exist in superset_config.py; set KEYCLOAK_CLIENT_SECRET here for login to work.
# ---------------------------------------------------------------------------
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Embedded dashboards / charts
# ---------------------------------------------------------------------------
# Comma-separated origins permitted to embed Superset (frame-ancestors) and
# call its REST API from the browser (CORS). Add your admin portal URL(s).
EMBEDDED_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://dsrfhir.intellisoftkenya.com:8080,https://dsradmin.intellisoftkenya.com

# Role assigned to embedded/guest users — must exist in Superset and have
# read access to the dashboards you want to expose.
GUEST_ROLE_NAME=Public

# Secret used to sign guest tokens. If unset, falls back to
# SUPERSET_SECRET_KEY. Generate with: openssl rand -base64 42
GUEST_TOKEN_JWT_SECRET=
GUEST_TOKEN_JWT_EXP_SECONDS=300

# Read-only connection to the analytics Postgres (fhir-data-pipes analytics-postgres), for the
# "NPHIIS Analytics (Postgres)" database that nphiis-analytics/vhf_postgres_setup.py creates.
# Password: ANALYTICS_RO_PASSWORD in fhir-data-pipes/docker/analytics-postgres.env.
ANALYTICS_DB_URI=postgresql+psycopg2://superset_ro:change-me@analytics-postgres:5432/fhir_analytics

# Which engine the VHF dashboards use: spark (default) or postgres (vhf_postgres_setup.py --switch).
NPHIIS_VHF_SOURCE=spark

# Copy this file to .env and fill in your values.
# Do not commit .env (it typically contains secrets).

# -----------------------------------------------------------------------
# REQUIRED: Superset secret key (CVE-2023-27524)
# Set a unique random value. Generate with: openssl rand -base64 42
# Without this, Superset may use an insecure default and allow session
# forgery / unauthenticated admin access. See superset.apache.org/docs/security/cves
# -----------------------------------------------------------------------
SUPERSET_SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET

# Database (Superset metadata)
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=superset

# Examples database (optional)
EXAMPLES_USER=
EXAMPLES_PASSWORD=
EXAMPLES_HOST=db
EXAMPLES_PORT=5432
EXAMPLES_DB=superset_examples

# Redis (cache / Celery)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1

# Superset behavior
SUPERSET_LOG_LEVEL=info
SUPERSET_LOAD_EXAMPLES=yes

# Keycloak OAuth2 (if using NPHIIS Auth)
# KEYCLOAK_URL=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

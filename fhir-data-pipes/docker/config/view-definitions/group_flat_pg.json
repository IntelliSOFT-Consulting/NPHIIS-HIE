{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "group_flat_pg",
  "status": "active",
  "resource": "Group",
  "select": [
    {
      "column": [
        {
          "name": "id",
          "path": "getResourceKey()",
          "type": "string"
        },
        {
          "name": "code",
          "path": "code.coding.first().code",
          "type": "string"
        },
        {
          "name": "name",
          "path": "name",
          "type": "string"
        },
        {
          "name": "active",
          "path": "active",
          "type": "boolean"
        },
        {
          "name": "quantity",
          "path": "quantity",
          "type": "integer"
        },
        {
          "name": "index_patient_id",
          "path": "characteristic.where(code.coding.code = 'index-case').value.ofType(Reference).getReferenceKey(Patient)",
          "type": "string"
        },
        {
          "name": "managing_location_id",
          "path": "meta.tag.where(system.endsWith('managingLocation')).code.first()",
          "type": "string"
        },
        {
          "name": "last_updated",
          "path": "meta.lastUpdated",
          "type": "string"
        }
      ]
    }
  ]
}

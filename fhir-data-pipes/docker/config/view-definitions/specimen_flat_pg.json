          "type": "string"
        },
        {
          "name": "type_code",
          "path": "type.coding.first().code",
          "type": "string"
        },
        {
          "name": "type_text",
          "path": "type.text",
          "type": "string"
        },
        {
          "name": "accession",
          "path": "accessionIdentifier.value",
          "type": "string"
        },
        {
          "name": "status",
          "path": "status",
          "type": "string"
        },
        {
          "name": "collected",
          "path": "collection.collected.ofType(dateTime)",
          "type": "string"
        },
        {
          "name": "received",
          "path": "receivedTime",
          "type": "string"
        },
        {
          "name": "managing_location_id",
          "path": "meta.tag.where(system.endsWith('managingLocation')).code.first()",
          "type": "string"
        },
        {
          "name": "last_updated",
          "path": "meta.lastUpdated",
          "type": "string"
        }
      ]
    }
  ]
}

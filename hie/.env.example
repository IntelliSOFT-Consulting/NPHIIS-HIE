# Postgres passwords, interpolated by docker compose into hie/docker-compose.yml,
# hie/docker-compose-dev.yml and keycloak/docker-compose*.yml. Copy to hie/.env
# (gitignored) and fill in; never commit real values.
# When running start-hie.sh, compose reads this file from hie/ (the first -f file's directory).
HAPI_DB_PASSWORD=
NPHIIS_DB_PASSWORD=
# Must match KC_DB_PASSWORD in keycloak/.env
KC_DB_PASSWORD=
